{
  "permissions": {
    "allow": [
      "Bash(bash .claude/hooks/story_model_id.sh --resolve:*)",
      "Bash(bash .claude/skills/story-flow-status/scripts/scan.sh)",
      "Bash(bash .claude/skills/story-flow-status/scripts/scan.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/story_involve_gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/story_commit_guard.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/story_bash_gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/story_model_id.sh",
            "statusMessage": "Recording session model id for STORY provenance"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/story_memory.sh",
            "statusMessage": "Loading STORY project memory"
          }
        ]
      }
    ]
  }
}
