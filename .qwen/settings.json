{
  "permissions": {
    "allow": [
      "Bash(bash .qwen/skills/story-flow-status/scripts/scan.sh)",
      "Bash(bash .qwen/skills/story-flow-status/scripts/scan.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "edit|write_file|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR\"/.qwen/hooks/story_involve_gate.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR\"/.qwen/hooks/story_commit_guard.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR\"/.qwen/hooks/story_model_id.sh",
            "statusMessage": "Recording session model id for STORY provenance",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR\"/.qwen/hooks/story_memory.sh",
            "statusMessage": "Loading STORY project memory",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
