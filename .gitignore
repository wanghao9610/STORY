# local runtime config
.env

# Project memory that stays on this machine, ignored the way .env is: machine:
# scoped facts and any memory the author keeps off the repository. The versioned
# store .story/memory/ travels with a clone; local/ does not.
.story/memory/local/

# builds and ephemeral reports live out-of-tree
wkdrs/*
!wkdrs/.gitkeep

# Editor and IDE build directories inside the manuscript. run.sh builds
# out-of-tree into wkdrs/, but LaTeX extensions (VS Code LaTeX Workshop and
# friends) write beside the sources; manus/ has to stay free of build products
# whatever produced them.
manus/out/
.vscode/ltex*
.texpadtmp/

# LaTeX junk (belt and suspenders; run.sh builds out-of-tree). The backups and
# log are latexindent's: fmt.sh keeps both in a temp directory, a bare
# `latexindent -w` run by hand does not.
*.bak[0-9]*
indent.log
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.synctex.gz
*.toc
# ...but never evidence. MANIFEST.md fingerprints every file under mates/,
# whatever its extension, so a registered train.log or SLURM *.out has to stay
# trackable. Keep this above .DS_Store, which stays ignored there too.
!/mates/**

.DS_Store
