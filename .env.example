# Optional default evidence repository. Use --source for additional STAR,
# STAGE, STORY, or generic research repositories.
RESEARCH_HOME=

# Thesis entry point, relative to the repository root. Degree level is an
# institutional fact recorded as degree_level in degree/profile.tex, not here.
# Use manus/main-zh.tex for the Simplified Chinese starter.
STORY_MAIN=manus/main.tex

# Build engine: pdflatex | xelatex | lualatex. Leave empty to honor a
# % !TeX program line in the entry point, then fall back to pdflatex.
LATEX_ENGINE=

# Upstream STORY template used by execs/update.sh
STORY_REPOSITORY=https://github.com/wanghao9610/STORY.git

# Harness trees updated or adopted: comma-separated names, all, or none.
# Valid names: claude, codex, cursor, dsh, kimi, pi, qwen — each names the
# matching dot-directory (kimi owns .kimi-code/).
STORY_HARNESSES=all

# Agent involvement: low | medium | high — how much unresolved workflow
# judgment a skill asks about under the authority you already gave (writing
# workflow conventions §7): low takes the recommended safe option and says so;
# medium asks as each skill documents; high asks each consequential choice on
# its own. Approval you already gave stays valid for its scope and is not asked
# for again. Institutional facts, attribution, thesis-wide argument or
# chapter-boundary changes, publication reuse, deletion, overwriting, and a
# deposit freeze still need your specific confirmation at every level, and a
# status, audit, or mock-review request ends with its own report and never
# authorizes a writing successor.
#
# low also skips the permission prompt for an edit inside the project (Claude
# Code, Codex, Qwen Code) and for a shell command outside the red lines (Claude
# Code); writes into mates/ (other than through execs/scpts/import.sh), degree/,
# and miles/*/feedback/ keep their prompt at every level. In Claude Code
# the hooks take an involve=<level> token from the most recent STORY command you
# typed and keep it after that run ends, until your next STORY command; a bare
# one, such as /story-flow-status, returns them to this value.
INVOLVE=medium

# Replies and newly written Markdown: en | zh. An explicit request in the
# conversation wins; empty or invalid follows the conversation's language. An
# existing file keeps its language, and degree/profile.tex sets the manuscript's.
STORY_LANG=
