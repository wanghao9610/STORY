# Optional default evidence repository. Use --source for additional STAR,
# STAGE, STORY, or generic research repositories.
RESEARCH_HOME=

# Thesis entry point, relative to the repository root. Degree level is an
# institutional fact recorded as degree_level in degree/profile.tex, not here.
# Use manus/main-zh.tex for the Simplified Chinese starter.
STORY_MAIN=manus/main.tex

# Build engine: pdflatex | xelatex | lualatex. Leave empty to honor a
# % !TeX program line in the entry point, then fall back to pdflatex.
LATEX_ENGINE=

# Upstream STORY template used by execs/update.sh
STORY_REPOSITORY=https://github.com/wanghao9610/STORY.git

# Harness trees updated or adopted: comma-separated names, all, or none.
# Valid names: claude, codex, cursor, dsh, kimi, pi, qwen — each names the
# matching dot-directory (kimi owns .kimi-code/).
STORY_HARNESSES=all

# Agent involvement: low | medium | high
INVOLVE=medium

# Replies and newly written Markdown: en | zh; empty follows the conversation.
STORY_LANG=
